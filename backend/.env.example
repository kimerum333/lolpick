APP_ENV=development
SYSTEM_LOG_ENABLED=true
# Copy the URI from Supabase Connect > Session pooler (port 5432).
# Percent-encode PASSWORD characters (e.g. @ -> %40, # -> %23, $ -> %24).
DATABASE_URL=postgresql+psycopg://lolpick_runtime.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# Optional direct/session connection for migrations using the schema-owner account.
# Configure a separate owner credential before running Alembic/operator tools. Do not use Transaction pooler on port 6543.
MIGRATION_DATABASE_URL=
DB_SCHEMA=lolpick
# Production requires verify-full and a trusted CA file (or libpq system trust).
DB_SSLMODE=verify-full
DB_SSLROOTCERT=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_CONNECT_TIMEOUT=5
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Auth uses the HTTPS Project URL, not the PostgreSQL connection URI.
# Copy a publishable key (sb_publishable_...) from Supabase Settings > API Keys.
SUPABASE_URL=https://cxvfjpqanqsjqdiyjcjr.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_TIMEOUT=5
# PandaScore server-side token. Never put this in a VITE_* variable.
PANDASCORE_TOKEN=
PANDASCORE_TIMEOUT=10
PANDASCORE_COLLECTION_BUDGET_SECONDS=60
PANDASCORE_PAGE_SIZE=100
PANDASCORE_MAX_PAGES=20
PANDASCORE_RETRIES=2
PANDASCORE_MAX_RETRY_DELAY=5
# Close the display bettingOpen flag when provider data is older than this.
PANDASCORE_MAX_STALENESS_SECONDS=4500
# Public last-known snapshots: memory only, per worker, all betting flags closed.
PUBLIC_SNAPSHOT_MAX_AGE_SECONDS=86400
PUBLIC_CIRCUIT_SECONDS=5
# For the hourly systemd timer only; first bind/import the actual season and series.
# PANDASCORE_SEASON_ID=worlds-2026
# PANDASCORE_SERIES_ID=ACTUAL_NUMERIC_ID

# Optional absolute Linux directory, e.g. /var/log/lolpick. Default: backend/logs.
# LOG_DIRECTORY=/var/log/lolpick
# SYSTEM_LOG_ENABLED controls only DB copies. Local audit output always remains on.

# v0.8: durable journal + shared host rate limits. Keep this directory across restarts.
AUDIT_MAX_EVENTS=200000
AUDIT_MAX_BYTES=268435456
AUDIT_RETENTION_DAYS=30
# Days affect only DB-delivered SQLite outbox rows, NEVER the append-only files.
AUDIT_FILE_SEGMENT_BYTES=52428800
REQUEST_BODY_TIMEOUT=5
REQUEST_MAX_CONCURRENT=32
RATE_PUBLIC_PER_MINUTE=120
RATE_AUTH_PER_MINUTE=20
RATE_ADMIN_PER_MINUTE=30
RATE_AUTH_IP_PER_MINUTE=120
RATE_ADMIN_IP_PER_MINUTE=120
RATE_MEMBER_PER_MINUTE=120
RATE_SESSION_PER_MINUTE=90
ADMIN_REQUIRE_MFA=true
# Trust X-Real-IP only from the explicitly configured proxy address.
# Nginx must overwrite X-Real-IP, and Uvicorn should use --no-proxy-headers.
TRUSTED_PROXY_CIDRS=[]
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
DB_TRANSACTION_BUDGET_SECONDS=30
# Production requires SYSTEM_LOG_ENABLED=true. Windows requires private NTFS ACL.
