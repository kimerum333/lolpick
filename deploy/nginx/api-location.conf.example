# Merge these locations into the EXISTING server block serving the Vue build.
# Assumes Nginx runs on the same AWS host and backend is published on loopback.
# If Nginx runs in Docker, join the Compose network and use http://backend:8000.
location /api/ {
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    client_max_body_size 1m;
}
